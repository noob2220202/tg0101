// Telegram auto-join SaaS — data model.
//
// SQLite has no native enum/array/json support, so status columns are plain
// strings and the allowed values live in src/lib/enums.ts. Keyword lists are
// stored comma-separated, option bags as JSON text.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Operators (tenants)
// ---------------------------------------------------------------------------

/// A person who signs in to the console. Every Telegram account, target and
/// collected link belongs to exactly one of these.
model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String

  /// ADMIN | MEMBER — see UserRole. Admins may manage other operators.
  role String @default("MEMBER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       UserSession[]
  accounts       Account[]
  targets        Target[]
  jobs           JoinJob[]
  collectedLinks CollectedLink[]
  policy         CollectionPolicy?
}

/// A signed-in browser session. The cookie holds `token`; nothing else.
model UserSession {
  id    String @id @default(cuid())
  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

/// A Telegram user account that performs joins. `sessionString` is an encrypted
/// MTProto StringSession.
model Account {
  id            String  @id @default(cuid())
  label         String
  phone         String?
  sessionString String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Cached Telegram profile, refreshed whenever the gateway connects.
  firstName      String?
  lastName       String?
  username       String?
  about          String?
  photoUpdatedAt DateTime?

  /// ACTIVE | COOLDOWN | NEEDS_CHECK | DISABLED — see AccountStatus.
  status String @default("NEEDS_CHECK")

  /// Telegram-imposed wait ("텔레그램이 51966초 대기를 요구했습니다").
  cooldownUntil   DateTime?
  cooldownSeconds Int?
  cooldownReason  String?

  /// Pacing: minimum seconds between two joins on this account.
  joinIntervalSec Int @default(20)
  /// Safety valve: hard cap on joins per calendar day. 0 = unlimited.
  dailyJoinLimit  Int @default(0)

  /// Participate in the background promo-link collector.
  collectEnabled Boolean @default(true)

  lastJoinAt    DateTime?
  lastCollectAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs        JoinJob[]
  tasks       JoinTask[]
  logs        JoinLog[]
  memberships Membership[]
  roomScans   RoomScan[]
  policies    CollectionPolicy[]
  dialogs     Dialog[]
  messages    ChatMessage[]
  health      AccountHealth?

  @@unique([ownerId, label])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Targets (rooms we want to be in)
// ---------------------------------------------------------------------------

/// A group/channel we intend to join. Identified by `key`: either a public
/// username (`somegroup`) or a private invite hash (`+AbCdEf...`).
model Target {
  id  String @id @default(cuid())
  key String

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// PUBLIC | PRIVATE — see TargetKind.
  kind        String  @default("PUBLIC")
  title       String?
  /// GROUP | CHANNEL | BOT | USER | UNKNOWN — see EntityType.
  entityType  String  @default("UNKNOWN")
  memberCount Int?

  /// MANUAL | AUTO_COLLECT — how the link entered the system.
  source   String  @default("MANUAL")
  note     String?
  archived Boolean @default(false)

  lastCheckedAt DateTime?
  /// "말을 걸어 숨은 선행 채널 찾기" is attempted at most once per room.
  probedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  prerequisites Prerequisite[]        @relation("TargetPrerequisites")
  requiredBy    Prerequisite[]        @relation("PrerequisiteOf")
  tasks         JoinTask[]
  memberships   Membership[]
  logs          JoinLog[]
  roomScans     RoomScan[]
  collectedFrom CollectedLinkSource[]
  collectedLink CollectedLink?

  @@unique([ownerId, key])
  @@index([archived])
  @@index([source])
}

/// "선행 채널" — a room that must be joined before `target` will let us in.
/// Learned once, reused on every later job.
model Prerequisite {
  id String @id @default(cuid())

  targetId String
  target   Target @relation("TargetPrerequisites", fields: [targetId], references: [id], onDelete: Cascade)

  /// The room that has to be joined first.
  requiredId String
  required   Target @relation("PrerequisiteOf", fields: [requiredId], references: [id], onDelete: Cascade)

  /// AUTO_NOTICE | PROBE | MANUAL — how we learned about it.
  discoveredVia String   @default("AUTO_NOTICE")
  discoveredAt  DateTime @default(now())

  @@unique([targetId, requiredId])
}

/// Proof that an account is already inside a room (drives "이미 입장한 선행
/// 채널은 건너뛰기").
model Membership {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  targetId String
  target   Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  chatId   String?
  joinedAt DateTime @default(now())
  left     Boolean  @default(false)

  @@unique([accountId, targetId])
  @@index([accountId, left])
}

// ---------------------------------------------------------------------------
// Jobs & queue
// ---------------------------------------------------------------------------

/// A batch of joins reserved from the UI ("72개 방 입장").
model JoinJob {
  id   String  @id @default(cuid())
  name String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// RUNNING | PAUSED | DONE | CANCELLED — see JobStatus.
  status String @default("RUNNING")

  /// JSON blob of the reservation dialog's toggles — see JobOptions.
  options String @default("{}")

  totalCount   Int @default(0)
  doneCount    Int @default(0)
  failedCount  Int @default(0)
  skippedCount Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  tasks JoinTask[]

  @@index([status])
}

/// One join attempt within a job.
model JoinTask {
  id String @id @default(cuid())

  jobId String
  job   JoinJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  targetId String
  target   Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  /// PENDING | RUNNING | WAITING_APPROVAL | SUCCESS | FAILED | SKIPPED.
  status String @default("PENDING")

  /// Prerequisites are queued ahead of the task that discovered them.
  priority     Int     @default(100)
  isPrereq     Boolean @default(false)
  parentTaskId String?

  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  nextAttemptAt DateTime  @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  lastError     String?
  lastErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, targetId])
  @@index([status, nextAttemptAt])
  @@index([accountId, status])
}

/// Append-only feed behind "최근 입장 기록".
model JoinLog {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  targetId String?
  target   Target? @relation(fields: [targetId], references: [id], onDelete: SetNull)

  /// INFO | WARN | ERROR — drives the dot colour in the feed.
  level String @default("INFO")

  /// Snapshot of the room title so the feed survives target deletion.
  targetLabel String?
  message     String
  taskId      String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([accountId, createdAt])
}

// ---------------------------------------------------------------------------
// Promo-link collection
// ---------------------------------------------------------------------------

/// Bookkeeping for the collector: which rooms have been swept and when.
model RoomScan {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  targetId String
  target   Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  lastScanAt    DateTime?
  lastMessageId Int?
  scanCount     Int       @default(0)
  nextScanAt    DateTime  @default(now())

  @@unique([accountId, targetId])
  @@index([nextScanAt])
}

/// A t.me link harvested from a room we are already in.
model CollectedLink {
  id  String @id @default(cuid())
  key String

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  url         String
  title       String?
  description String?

  /// GROUP | CHANNEL | BOT | USER | UNKNOWN — resolved against Telegram.
  entityType  String @default("UNKNOWN")
  memberCount Int?

  /// 0-100 confidence that this is a joinable promo room.
  score  Int    @default(0)
  /// Human-readable "판정 사유".
  reason String @default("")

  /// PENDING | APPROVED | REGISTERED | EXCLUDED — see LinkStatus.
  status String @default("PENDING")

  /// How many distinct rooms mentioned it, and total mentions.
  roomCount Int @default(0)
  seenCount Int @default(0)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolvedAt  DateTime?

  registeredTargetId String? @unique
  registeredTarget   Target? @relation(fields: [registeredTargetId], references: [id], onDelete: SetNull)

  sources CollectedLinkSource[]

  @@unique([ownerId, key])
  @@index([status, score])
  @@index([lastSeenAt])
}

/// Which room a collected link was seen in, and how often.
model CollectedLinkSource {
  id String @id @default(cuid())

  linkId String
  link   CollectedLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  sourceTargetId String?
  sourceTarget   Target? @relation(fields: [sourceTargetId], references: [id], onDelete: SetNull)

  /// Snapshot of the source room title for display.
  sourceLabel String?
  count       Int      @default(1)
  lastSeenAt  DateTime @default(now())

  @@unique([linkId, sourceTargetId])
}

/// Singleton-ish settings behind the "홍보 링크 수집 정책" dialog.
model CollectionPolicy {
  id String @id @default(cuid())

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  enabled      Boolean @default(true)
  autoRegister Boolean @default(true)

  minScore   Int @default(70)
  dailyLimit Int @default(100)

  /// Account used to auto-join freshly registered rooms. Null = register only.
  joinAccountId String?
  joinAccount   Account? @relation(fields: [joinAccountId], references: [id], onDelete: SetNull)

  /// 연쇄 수집: keep collecting from rooms that were auto-joined.
  chainCollect Boolean @default(true)

  collectGroups   Boolean @default(true)
  collectChannels Boolean @default(false)
  collectBots     Boolean @default(false)
  collectUsers    Boolean @default(false)

  minMembers Int @default(0)

  /// Comma-separated keyword lists.
  requiredKeywords String @default("")
  excludedKeywords String @default("")

  /// Rolling counter for `dailyLimit`.
  registeredToday Int    @default(0)
  counterDate     String @default("")

  updatedAt DateTime @default(now()) @updatedAt
}

/// Free-form key/value store for global settings (default pacing, etc.).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// ---------------------------------------------------------------------------
// Chat (web Telegram client)
// ---------------------------------------------------------------------------

/// A conversation in an account's chat list.
///
/// This is a cache of what Telegram already knows, kept so the dialog list
/// renders instantly and unread counts can be summed across accounts without
/// waking every session.
model Dialog {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// Telegram peer id as a string (bigint values do not fit an Int).
  peerId   String
  /// USER | GROUP | CHANNEL | BOT — see EntityType.
  peerType String @default("UNKNOWN")

  title    String?
  username String?

  unreadCount     Int       @default(0)
  lastMessageId   Int?
  lastMessageText String?
  lastMessageAt   DateTime?
  /// True when the newest message is one we sent.
  lastMessageOut  Boolean   @default(false)

  pinned   Boolean @default(false)
  muted    Boolean @default(false)
  archived Boolean @default(false)

  syncedAt DateTime @default(now())

  @@unique([accountId, peerId])
  @@index([accountId, archived, lastMessageAt])
}

/// A cached message.
///
/// Only two kinds of message are stored: those in conversations the operator
/// has actually opened, and those that matched a keyword rule. Persisting every
/// message from several hundred promo rooms is neither useful nor affordable.
model ChatMessage {
  id String @id @default(cuid())

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  peerId    String
  messageId Int

  outgoing   Boolean @default(false)
  senderId   String?
  senderName String?

  text String @default("")

  /// PHOTO | DOCUMENT | VIDEO | VOICE | STICKER | OTHER — null for plain text.
  mediaType String?
  /// Set once the media has been downloaded into the local cache.
  mediaPath String?
  mediaName String?

  /// True when the row was kept because a keyword rule matched.
  keywordHit Boolean @default(false)

  date      DateTime
  createdAt DateTime @default(now())

  @@unique([accountId, peerId, messageId])
  @@index([accountId, peerId, messageId])
  @@index([keywordHit, date])
}

/// "이 단어가 뜨면 알려줘" — evaluated against the live update stream.
model KeywordRule {
  id String @id @default(cuid())

  ownerId String
  name    String

  /// Comma-separated terms; a message matching any of them is a hit.
  terms String

  /// Restrict to one account, or null for every account the operator owns.
  accountId String?

  enabled   Boolean   @default(true)
  hitCount  Int       @default(0)
  lastHitAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, enabled])
}

// ---------------------------------------------------------------------------
// Account health
// ---------------------------------------------------------------------------

/// Spam-block status and activity budget for one account.
///
/// Telegram does not expose "are you limited?" over the API, but @SpamBot
/// answers the question in plain text, so the worker asks it periodically and
/// parses the reply.
model AccountHealth {
  id String @id @default(cuid())

  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// OK | LIMITED | UNKNOWN — see SpamStatus.
  spamStatus      String    @default("UNKNOWN")
  /// Verbatim @SpamBot reply, so an unparsed answer is still readable.
  spamMessage     String?
  /// End of the restriction, when @SpamBot names a date.
  restrictedUntil DateTime?
  checkedAt       DateTime?

  /// 0-100. Higher means closer to being limited — see src/lib/health.ts.
  riskScore  Int    @default(0)
  /// Why the score is what it is, in Korean.
  riskReason String @default("")

  updatedAt DateTime @default(now()) @updatedAt
}
