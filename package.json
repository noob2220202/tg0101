{
  "name": "tg-autojoin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx watch src/worker/main.ts",
    "worker:once": "tsx src/worker/main.ts --once",
    "worker:prod": "tsx src/worker/main.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "setup:prod": "prisma generate && prisma db push",
    "deploy": "npm run build && pm2 startOrReload ecosystem.config.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "teleproto": "^1.228.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
