# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Telegram MTProto credentials (https://my.telegram.org -> API development tools)
# Every account added through the UI logs in with these app credentials.
# ---------------------------------------------------------------------------
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Seconds between worker ticks.
WORKER_TICK_SECONDS="5"
# Set to "1" to run the worker against an in-memory fake Telegram instead of the
# real network. Useful for developing the UI without burning real accounts.
MOCK_TELEGRAM="0"
# Encryption key for stored MTProto session strings (32+ chars).
# Once accounts are connected this can never be changed — doing so makes every
# stored Telegram session undecryptable.
SESSION_SECRET="change-me-please-use-a-long-random-string"

# Session cookies are marked Secure in production, and a browser silently
# discards a Secure cookie over plain HTTP — the symptom is a login that
# appears to do nothing. Browsers exempt localhost, so this only matters when
# reaching the app by IP or hostname without TLS. Set to "0" for that case.
# COOKIE_SECURE="0"

# ---------------------------------------------------------------------------
# Gateway
#
# Only one process may hold an MTProto connection per account, so the worker
# owns every session and exposes them over loopback. The web app talks to
# Telegram exclusively through this.
# ---------------------------------------------------------------------------
GATEWAY_PORT="4599"
GATEWAY_URL="http://127.0.0.1:4599"
# Shared secret between the web app and the gateway.
GATEWAY_TOKEN="change-me-too"
# Where downloaded chat media is cached.
MEDIA_DIR=".media"
